# Copy to .env for local development. Never commit .env.

# Where quote requests are stored: "file" (local .data/requests.json) or "firestore".
STORAGE=file
# Only needed for Firestore outside Google Cloud (Cloud Run detects it automatically).
GOOGLE_CLOUD_PROJECT=
# Named Firestore database; leave empty for "(default)". Staging uses "staging".
FIRESTORE_DATABASE=

# "staging" adds a noindex header so lesspane.net stays out of search results.
APP_ENV=development

# Owner page at /admin uses HTTP Basic auth (any username, this password).
# Leave empty to disable /admin entirely.
ADMIN_PASSWORD=change-me

# Email notifications via Resend (https://resend.com). Leave the key empty to log emails to the console instead.
RESEND_API_KEY=
EMAIL_FROM=LessPane <hello@lesspane.com>
OWNER_EMAIL=you@example.com

# ---- Google Workspace (optional; see README "Google Workspace"). Leave empty locally. ----
# Send email through Gmail as this Workspace user (domain-wide delegation). EMAIL_FROM must be one of its
# send-as addresses. Only works on Cloud Run, where the service account can sign delegation tokens.
GMAIL_USER=
# Calendar sync: the Workspace user and calendar (defaults: GMAIL_USER and their primary calendar).
CALENDAR_USER=
CALENDAR_ID=
# Google sign-in for /admin. Without GOOGLE_CLIENT_ID, /admin uses ADMIN_PASSWORD (Basic auth).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
ADMIN_EMAILS=
