# Copy to .env for local development. Never commit .env.

# Where quote requests are stored: "file" (local .data/requests.json) or "firestore".
STORAGE=file
# Only needed for Firestore outside Google Cloud (Cloud Run detects it automatically).
GOOGLE_CLOUD_PROJECT=

# Owner page at /admin uses HTTP Basic auth (any username, this password).
# Leave empty to disable /admin entirely.
ADMIN_PASSWORD=change-me

# Email notifications via Resend (https://resend.com). Leave the key empty to log emails to the console instead.
RESEND_API_KEY=
EMAIL_FROM=LessPane <hello@lesspane.com>
OWNER_EMAIL=you@example.com
