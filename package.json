{
  "name": "lesspane",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "LessPane prototype: instant window washing quotes and booking requests.",
  "scripts": {
    "dev": "vite dev --host ::",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "seed": "node scripts/seed.mjs",
    "verify": "npm run check && npm test && npm run build",
    "docker:run": "export DOCKER_CONFIG=$(mktemp -d) && docker build -t lesspane . && docker run --rm -p 8080:8080 --env-file .env -e ORIGIN=http://localhost:8080 lesspane",
    "deploy:staging": "gcloud builds submit --project lesspane --config cloudbuild.yaml --substitutions=_SERVICE=lesspane-staging,_APP_ENV=staging,_FIRESTORE_DATABASE=staging,_ADMIN_SECRET=lesspane-staging-admin-password",
    "icons": "node scripts/icons.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.0",
    "google-auth-library": "^9.15.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^5.2.12",
    "@sveltejs/kit": "^2.20.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@types/node": "^22.13.0",
    "svelte": "^5.25.0",
    "svelte-check": "^4.1.5",
    "typescript": "^5.8.0",
    "vite": "^6.2.0",
    "vitest": "^3.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
