{
  "name": "lesspane",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "description": "LessPane prototype: instant window washing quotes and booking requests.",
  "scripts": {
    "dev": "vite dev --host ::",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "seed": "node scripts/seed.mjs",
    "verify": "npm run check && npm test && npm run build",
    "docker:run": "export DOCKER_CONFIG=$(mktemp -d) && docker build -t lesspane . && docker run --rm -p 8080:8080 --env-file .env -e ORIGIN=http://localhost:8080 lesspane",
    "deploy:staging": "gcloud builds submit --project lesspane --config cloudbuild.yaml",
    "icons": "node scripts/icons.mjs",
    "smoke:agent": "node scripts/agent-smoke.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "^9.4.1",
    "@google/genai": "3.6.1",
    "google-auth-library": "^11.3.4"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@sveltejs/adapter-node": "^6.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^22.13.0",
    "svelte": "^5.58.0",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
